        "# Wpływ chunk_size: dwa dodatkowe ustawienia, oceniane tą samą metodą wektorową.\n",
        "# Każde ustawienie buduje osobną kolekcję Chroma.\n",
        "chunk_size_results = []\n",
        "vector_indexes_by_size = {}\n",
        "\n",
        "for size in [250, 650]:\n",
        "    alt_chunks, alt_collection, alt_vectors = make_vector_index(DOCS, chunk_size=size, chunk_overlap=min(60, size // 5))\n",
        "    vector_indexes_by_size[size] = (alt_chunks, alt_collection)\n",
        "    def alt_vector_search(question, k=TOP_K, cs=alt_chunks, coll=alt_collection):\n",
        "        q_emb = embed_texts([question])[0]\n",
        "        result = coll.query(query_embeddings=[q_emb], n_results=min(k, len(cs)))\n",
        "        by_id = {c[\"id\"]: c for c in cs}\n",
        "        return [by_id[cid] for cid in result[\"ids\"][0] if cid in by_id]\n",
        "    scores = evaluate(alt_vector_search)\n",
        "    chunk_size_results.append({\"chunk_size\": size, **scores})\n",
        "\n",
        "chunk_size_table = pd.DataFrame(chunk_size_results).set_index(\"chunk_size\")\n",
        "display(chunk_size_table)"
