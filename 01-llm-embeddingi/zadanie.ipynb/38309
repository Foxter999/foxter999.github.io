        "from rank_bm25 import BM25Okapi\n",
        "from sentence_transformers import CrossEncoder\n",
        "import pandas as pd\n",
        "import re\n",
        "from collections import defaultdict\n",
        "\n",
        "def tokenize(text):\n",
        "    return re.findall(r\"[\\wąćęłńóśźż]+\", text.lower())\n",
        "\n",
        "bm25 = BM25Okapi([tokenize(c[\"text\"]) for c in chunks])\n",
        "cross_encoder = CrossEncoder(\"cross-encoder/ms-marco-MiniLM-L-6-v2\")\n",
        "\n",
        "chunk_by_id = {c[\"id\"]: c for c in chunks}\n",
        "doc_by_id = {d[\"id\"]: d for d in DOCS}\n",
        "\n",
        "def vector_search(question, current_chunks=chunks, current_collection=collection, k=TOP_K):\n",
        "    q_emb = embed_texts([question])[0]\n",
        "    result = current_collection.query(query_embeddings=[q_emb], n_results=min(k, len(current_chunks)))\n",
        "    return [chunk_by_id[cid] for cid in result[\"ids\"][0] if cid in chunk_by_id]\n",
        "\n",
        "def bm25_search(question, current_chunks=chunks, k=TOP_K):\n",
        "    scores = BM25Okapi([tokenize(c[\"text\"]) for c in current_chunks]).get_scores(tokenize(question))\n",
        "    order = np.argsort(scores)[::-1][:k]\n",
        "    return [current_chunks[i] for i in order]\n",
        "\n",
        "def rrf_fuse(rankings, k=60, limit=TOP_K):\n",
        "    \"\"\"Reciprocal Rank Fusion: sumuje 1/(k + pozycja) z list rankingowych.\"\"\"\n",
        "    scores = defaultdict(float)\n",
        "    by_id = {}\n",
        "    for ranking in rankings:\n",
        "        for rank, chunk in enumerate(ranking, start=1):\n",
        "            scores[chunk[\"id\"]] += 1.0 / (k + rank)\n",
        "            by_id[chunk[\"id\"]] = chunk\n",
        "    ordered = sorted(scores, key=scores.get, reverse=True)[:limit]\n",
        "    return [by_id[cid] for cid in ordered]\n",
        "\n",
        "def hybrid_search(question, k=TOP_K):\n",
        "    return rrf_fuse([vector_search(question, k=max(k, 10)), bm25_search(question, k=max(k, 10))], limit=k)\n",
        "\n",
        "def rerank_search(question, k=TOP_K):\n",
        "    candidates = hybrid_search(question, k=10)\n",
        "    if not candidates:\n",
        "        return []\n",
        "    scores = cross_encoder.predict([(question, c[\"text\"]) for c in candidates])\n",
        "    return [c for _, c in sorted(zip(scores, candidates), key=lambda pair: pair[0], reverse=True)[:k]]\n",
        "\n",
        "def evaluate(retriever, eval_set=EVAL):\n",
        "    hit1, hit3, reciprocal_ranks = [], [], []\n",
        "    for question, gold_doc_id, _ in eval_set:\n",
        "        ranking = retriever(question, k=TOP_K)\n",
        "        retrieved_doc_ids = [c[\"doc_id\"] for c in ranking]\n",
        "        hit1.append(int(bool(retrieved_doc_ids) and retrieved_doc_ids[0] == gold_doc_id))\n",
        "        hit3.append(int(gold_doc_id in retrieved_doc_ids[:3]))\n",
        "        rr = 0.0\n",
        "        for rank, found_id in enumerate(retrieved_doc_ids, start=1):\n",
        "            if found_id == gold_doc_id:\n",
        "                rr = 1.0 / rank\n",
        "                break\n",
        "        reciprocal_ranks.append(rr)\n",
        "    return {\n",
        "        \"hit@1\": round(float(np.mean(hit1)), 3),\n",
        "        \"hit@3\": round(float(np.mean(hit3)), 3),\n",
        "        \"MRR\": round(float(np.mean(reciprocal_ranks)), 3),\n",
        "    }\n",
        "\n",
        "methods = {\n",
        "    \"Wektory\": vector_search,\n",
        "    \"BM25\": bm25_search,\n",
        "    \"Hybryda RRF\": hybrid_search,\n",
        "    \"Hybryda + reranking\": rerank_search,\n",
        "}\n",
        "results = pd.DataFrame({name: evaluate(fn) for name, fn in methods.items()}).T\n",
        "results.index.name = \"Metoda\"\n",
        "display(results)"
      ],
