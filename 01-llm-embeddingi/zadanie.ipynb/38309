        "import json\n",
        "\n",
        "def llm_judge(question, answer, context):\n",
        "    \"\"\"LLM ocenia wierność kontekstowi i poprawność odpowiedzi w skali 1–5.\"\"\"\n",
        "    prompt = f\"\"\"Oceń odpowiedź systemu RAG wyłącznie na podstawie kontekstu.\n",
        "Zwróć tylko poprawny JSON o polach:\n",
        "faithfulness (liczba 1-5), correctness (liczba 1-5), justification (jedno zdanie).\n",
        "faithfulness: czy odpowiedź jest poparta kontekstem.\n",
        "correctness: czy odpowiedź poprawnie odpowiada na pytanie i nie dodaje nieuzasadnionych faktów.\n",
        "Jeśli odpowiedź brzmi „Nie wiem”, a kontekst nie zawiera odpowiedzi, przyznaj wysoką ocenę.\n",
        "Pytanie: {question}\n",
        "Kontekst: {context}\n",
        "Odpowiedź: {answer}\n",
        "\"\"\"\n",
        "    response = client.chat.completions.create(\n",
        "        model=CLASSIC,\n",
        "        messages=[\n",
        "            {\"role\": \"system\", \"content\": \"Jesteś skrupulatnym ewaluatorem. Zwracaj wyłącznie JSON.\"},\n",
        "            {\"role\": \"user\", \"content\": prompt},\n",
        "        ],\n",
        "    )\n",
        "    raw = response.choices[0].message.content or \"{}\"\n",
        "    match = re.search(r\"\\{.*\\}\", raw, flags=re.S)\n",
        "    try:\n",
        "        data = json.loads(match.group(0) if match else raw)\n",
        "    except json.JSONDecodeError:\n",
        "        data = {\"faithfulness\": None, \"correctness\": None, \"justification\": f\"Nie udało się sparsować oceny: {raw[:200]}\"}\n",
        "    return data\n",
        "\n",
        "judge_rows = []\n",
        "for item in rag_results:\n",
        "    context = \"\\n\\n\".join(c[\"text\"] for c in item[\"context_chunks\"])\n",
        "    judgment = llm_judge(item[\"question\"], item[\"answer\"], context)\n",
        "    judge_rows.append({\n",
        "        \"question\": item[\"question\"],\n",
        "        \"answer\": item[\"answer\"],\n",
        "        \"sources\": \", \".join(item[\"sources\"]),\n",
        "        \"faithfulness\": judgment.get(\"faithfulness\"),\n",
        "        \"correctness\": judgment.get(\"correctness\"),\n",
        "        \"justification\": judgment.get(\"justification\"),\n",
        "    })\n",
        "\n",
        "judge_table = pd.DataFrame(judge_rows)\n",
